   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Each parallel worker has its own timeout (60–120s) and its own fallback (see MULTIAGENT.md).\nA failed worker degrades the brief instead of failing it; compose has no fallback — if it fails, the whole check fails.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
