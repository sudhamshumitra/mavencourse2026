  {
   "id": "el5",
   "type": "text",
   "x": 50,
   "y": 133.7,
   "width": 1310,
   "height": 50.7,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 6,
   "versionNonce": 6,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Grapevine finds academic conferences, journal calls and fellowships for researchers, and scores whether each one is worth\nthe time and money — fit, cost, funding, visa. This diagram shows what happens after someone clicks \"Full check\" on one\nresult: instead of one AI call doing everything, the work is split across several small, specialised AI agents.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "baseline": 13,
   "containerId": null,
   "originalText": "Grapevine finds academic conferences, journal calls and fellowships for researchers, and scores whether each one is worth\nthe time and money — fit, cost, funding, visa. This diagram shows what happens after someone clicks \"Full check\" on one\nresult: instead of one AI call doing everything, the work is split across several small, specialised AI agents.",
   "lineHeight": 1.3
  },
